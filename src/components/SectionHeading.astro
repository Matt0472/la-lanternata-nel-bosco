---
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'center' | 'left';
}
const { eyebrow, title, intro, align = 'center' } = Astro.props;
const alignCls = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignCls}`}>
  {
    eyebrow && (
      <p class="mb-3 text-sm font-bold tracking-[0.2em] text-lantern-deep uppercase" data-animate="fade-up">
        {eyebrow}
      </p>
    )
  }
  <h2 class="text-3xl leading-tight text-balance text-night sm:text-4xl lg:text-5xl" data-animate="fade-up" data-delay="0.1">
    {title}
  </h2>
  {
    intro && (
      <p
        class="mt-5 text-lg leading-relaxed text-pretty whitespace-pre-line text-night-soft"
        data-animate="fade-up"
        data-delay="0.2"
      >
        {intro}
      </p>
    )
  }
</div>
