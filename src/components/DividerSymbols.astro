<!-- Drawing used by the Divider, defined once per page: the lantern standing
     on the arc of the ticket passage. -->
<svg width="0" height="0" class="absolute" aria-hidden="true">
  <defs>
    <radialGradient id="divider-glow">
      <stop offset="0" stop-color="var(--color-lantern-light)" stop-opacity="0.7"></stop>
      <stop offset="1" stop-color="var(--color-lantern)" stop-opacity="0"></stop>
    </radialGradient>
    <symbol id="divider-lantern" viewBox="-22 -46 44 70" overflow="visible">
      <circle cx="0" cy="-16" r="22" fill="url(#divider-glow)"></circle>
      <circle cx="0" cy="-41" r="3.2" fill="none" stroke="var(--color-night)" stroke-width="2"></circle>
      <path d="M0 -38 L9 -31 H-9 Z" fill="var(--color-night)"></path>
      <rect x="-11" y="-31" width="22" height="4" rx="2" fill="var(--color-night)"></rect>
      <rect x="-8" y="-27" width="16" height="22" fill="var(--color-lantern-light)"></rect>
      <path d="M0 -22 c2.6 3 3.6 5 3.6 6.8 a3.6 3.6 0 0 1-7.2 0 c0-1.8 1-3.8 3.6-6.8 Z" fill="var(--color-cream)"></path>
      <path d="M-8 -27 V-5 M8 -27 V-5" stroke="var(--color-night)" stroke-width="2"></path>
      <rect x="-11" y="-5" width="22" height="4.5" rx="2" fill="var(--color-night)"></rect>
    </symbol>
  </defs>
</svg>
