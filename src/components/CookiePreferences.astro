<!-- Quiet twin of the back-to-top button, in the opposite corner: it opens the
     cookie preferences, so withdrawing consent is always one click away
     without weighing on the design. Like its twin it appears once the hero is
     scrolled past: on short phones it would cover the booking button. The
     footer link "Preferenze cookie" is always there. -->
<button
  id="cookie-preferences"
  type="button"
  tabindex="-1"
  aria-label="Gestisci le preferenze cookie"
  title="Preferenze cookie"
  class="pointer-events-none fixed bottom-5 left-5 z-40 grid h-11 w-11 translate-y-6 motion-reduce:translate-y-0 motion-reduce:scale-100 place-items-center rounded-full border border-night/15 bg-cream text-night-soft opacity-0 shadow-md shadow-night/15 transition-all duration-300 ease-soft hover:-translate-y-1 hover:text-night hover:opacity-100 hover:shadow-lg sm:bottom-8 sm:left-8"
  onclick="window.showCookiePreferences?.()"
>
  <svg
    class="h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12a9 9 0 1 1-9-9 3.5 3.5 0 0 0 3.5 3.5A2.5 2.5 0 0 0 18 9a3 3 0 0 0 3 3Z"></path>
    <circle cx="9" cy="9" r="0.5" fill="currentColor"></circle>
    <circle cx="8.5" cy="14.5" r="0.5" fill="currentColor"></circle>
    <circle cx="13" cy="16" r="0.5" fill="currentColor"></circle>
  </svg>
</button>

<script>
  const cookieBtn = document.getElementById('cookie-preferences')!;
  const hiddenCls = ['opacity-0', 'translate-y-6', 'pointer-events-none'];
  let shown = false;
  const toggle = () => {
    const show = window.scrollY > window.innerHeight * 0.8;
    if (show === shown) return;
    shown = show;
    hiddenCls.forEach((c) => cookieBtn.classList.toggle(c, !show));
    cookieBtn.classList.toggle('opacity-85', show);
    cookieBtn.tabIndex = show ? 0 : -1;
  };
  window.addEventListener('scroll', toggle, { passive: true });
  toggle();
</script>
