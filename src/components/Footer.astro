---
import Icon from './Icon.astro';
import Divider from './Divider.astro';
import LanternMark from './LanternMark.astro';
import contact from '../data/contact.json';
import settings from '../data/settings.json';
import hero from '../data/hero.json';

const year = new Date().getFullYear();

// Google reviews badge: static and editable from the panel (no Trustindex
// widget, which would be a third-party script under consent). The full stars
// come from the score, so they stay honest if it changes.
const g = contact.google ?? {};
const score = Number(String(g.score ?? '').replace(',', '.'));
const filled = Number.isFinite(score) && score > 0 ? Math.min(100, (score / 5) * 100) : 100;
// without an address the badge stays visible but not clickable (no dead links)
const BadgeTag = g.url ? 'a' : 'span';
const badgeAttrs = g.url ? { href: g.url, target: '_blank', rel: 'noopener' } : {};
---

<footer class="bg-night text-cream/80">
  <Divider from="paper" />
  <!-- less room below the closing line than above: the page ends there -->
  <div class="mx-auto max-w-6xl px-4 pt-14 pb-6 sm:px-6">
    <div class="mb-12 flex items-center justify-center gap-2 text-cream md:justify-start">
      <LanternMark class="h-14 w-auto" />
      <p class="font-display text-2xl leading-tight">
        {hero.title}
        {hero.tagline && <span class="block text-lg text-cream/70">{hero.tagline}</span>}
      </p>
    </div>

    <!-- on phones everything centred, in a column; from tablet up back in a row -->
    <div class="flex flex-col items-center justify-between gap-10 text-center md:flex-row md:items-center md:text-left">
      <!-- The box stays clickable everywhere, but it is not a link wrapping
           everything: the Google badge lives inside, and a link inside a link
           is not valid HTML. The park link is the CTA, "stretched" over the box
           with an ::after (see .park-cta), and the badge sits above it with z-10. -->
      <div class="park-box lift relative flex max-w-lg flex-col gap-4 rounded-3xl bg-cream/5 p-5">
        <!-- top row: the park mark and, next to it, Google's rating. The two
             tiles are identical in size by construction (see .park-tiles). -->
        <div class="park-tiles">
          <!-- The mark needs a light ground: its colours would be lost on night -->
          <span class="flex items-center justify-center rounded-2xl bg-cream px-3 py-3">
            <img src="/logo-bosco-419.png" alt="Logo Bosco della Luna" width="419" height="283" class="h-12 w-auto" />
          </span>

          {
            g.show && (
              <BadgeTag
                {...badgeAttrs}
                class="park-google relative z-10 flex flex-col items-center justify-center gap-1 rounded-2xl border border-night/10 bg-cream px-3 py-3 text-night shadow-sm"
              >
                {/* No aria-label here: it would replace the visible text instead
                    of containing it, and voice control saying "4,8" would not
                    activate the link. This hidden line adds the context the
                    stars give only to those who see them. */}
                <span class="sr-only">Recensioni Google del Bosco della Luna, punteggio su 5 stelle:</span>
                <span class="flex flex-wrap items-center justify-center gap-x-1.5 gap-y-0.5">
                  {/* Google's mark keeps its brand colours on cream (CODE-06) */}
                  <svg viewBox="0 0 48 48" class="h-4 w-4 shrink-0" aria-hidden="true">
                    <path
                      fill="#4285F4"
                      d="M45.12 24.5c0-1.56-.14-3.06-.4-4.5H24v8.51h11.84c-.51 2.75-2.06 5.08-4.39 6.64v5.52h7.11c4.16-3.83 6.56-9.47 6.56-16.17z"
                    />
                    <path
                      fill="#34A853"
                      d="M24 46c5.94 0 10.92-1.97 14.56-5.33l-7.11-5.52c-1.97 1.32-4.49 2.1-7.45 2.1-5.73 0-10.58-3.87-12.31-9.07H4.34v5.7C7.96 41.07 15.4 46 24 46z"
                    />
                    <path
                      fill="#FBBC05"
                      d="M11.69 28.18C11.25 26.86 11 25.45 11 24s.25-2.86.69-4.18v-5.7H4.34C2.85 17.09 2 20.45 2 24s.85 6.91 2.34 9.88l7.35-5.7z"
                    />
                    <path
                      fill="#EA4335"
                      d="M24 10.75c3.23 0 6.13 1.11 8.41 3.29l6.31-6.31C34.91 4.18 29.93 2 24 2 15.4 2 7.96 6.93 4.34 14.12l7.35 5.7c1.73-5.2 6.58-9.07 12.31-9.07z"
                    />
                  </svg>

                  {/* stars: a pale row below, the gold row on top clipped at --filled */}
                  <span class="park-stars" style={`--filled: ${filled}%`} aria-hidden="true">
                    <span class="park-stars-empty">
                      {[0, 1, 2, 3, 4].map(() => (
                        <svg viewBox="0 0 24 24" class="park-star">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                        </svg>
                      ))}
                    </span>
                    <span class="park-stars-full">
                      {[0, 1, 2, 3, 4].map(() => (
                        <svg viewBox="0 0 24 24" class="park-star">
                          <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                        </svg>
                      ))}
                    </span>
                  </span>

                  <span class="text-sm font-bold">{g.score}</span>
                </span>
                <span class="text-center text-[0.7rem] leading-tight font-semibold text-night-soft">{g.count}</span>
              </BadgeTag>
            )
          }
        </div>

        <div>
          <p class="text-sm leading-relaxed">{contact.parkTagline}</p>
          <a
            href={settings.parkUrl}
            target="_blank"
            rel="noopener"
            class="park-cta mt-1 inline-block font-bold text-lantern transition-colors duration-300"
          >
            {contact.parkCta} <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      {(settings.instagram || settings.facebook) && (
      <div class="flex items-center gap-4">
        <p class="text-sm font-semibold tracking-wide text-cream/70 uppercase">Seguici su</p>
        <nav class="flex gap-3" aria-label="Social">
          {settings.instagram && (
          <a
            href={settings.instagram}
            target="_blank"
            rel="noopener"
            aria-label="Instagram del Bosco della Luna"
            class="lift grid h-11 w-11 place-items-center rounded-full bg-cream/10 hover:bg-lantern hover:text-night"
          >
            <Icon name="instagram" class="h-5 w-5" />
          </a>
          )}
          {settings.facebook && (
          <a
            href={settings.facebook}
            target="_blank"
            rel="noopener"
            aria-label="Facebook del Bosco della Luna"
            class="lift grid h-11 w-11 place-items-center rounded-full bg-cream/10 hover:bg-lantern hover:text-night"
          >
            <Icon name="facebook" class="h-5 w-5" />
          </a>
          )}
        </nav>
      </div>
      )}
    </div>

    <div
      class="mt-12 flex flex-col items-center gap-3 border-t border-cream/10 pt-8 text-center text-xs sm:flex-row sm:items-center sm:justify-between sm:text-left"
    >
      <p>Copyright © {year} {settings.copyrightHolder}. Tutti i diritti sono riservati.</p>

      <!-- Developer's signature, in the middle of the closing line -->
      <p class="flex items-center justify-center gap-2 text-sm" lang="en">
        <span>Made with</span>
        <svg viewBox="0 0 24 24" class="h-5 w-5 shrink-0" role="img" aria-label="love">
          <path
            d="M12 21.2c-1.2-.9-8.6-5.8-8.6-11.6 0-3.1 2.3-5.2 5-5.2 1.6 0 3 .8 3.6 1.9.6-1.1 2-1.9 3.6-1.9 2.7 0 5 2.1 5 5.2 0 5.8-7.4 10.7-8.6 11.6z"
            fill="var(--color-lantern)"></path>
        </svg>
        <span>by</span>
        <a
          href="https://mapped-dev.it/"
          target="_blank"
          rel="noopener"
          class="font-bold text-lantern transition-colors duration-300 hover:text-cream"
        >
          Mattia Pedone
        </a>
      </p>
      <nav class="flex flex-wrap justify-center gap-x-4" aria-label="Note legali">
        <a href="/privacy/" class="inline-flex min-h-11 items-center underline transition-colors duration-300 hover:text-lantern">Privacy Policy</a>
        <a href="/cookie/" class="inline-flex min-h-11 items-center underline transition-colors duration-300 hover:text-lantern">Cookie Policy</a>
        <button
          type="button"
          class="min-h-11 cursor-pointer underline transition-colors duration-300 hover:text-lantern"
          onclick="window.showCookiePreferences?.()"
        >
          Preferenze cookie
        </button>
      </nav>
    </div>
  </div>
</footer>

<style>
  /* stretched link: see the comment on .park-box in the markup */
  .park-cta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
  }
  .park-box:hover {
    background-color: color-mix(in srgb, var(--color-cream) 10%, transparent);
  }
  .park-box:hover .park-cta {
    color: var(--color-cream);
  }
  /* On the Google badge the box must not pretend to be the park link */
  .park-box:has(.park-google:hover) {
    background-color: color-mix(in srgb, var(--color-cream) 5%, transparent);
  }
  .park-box:has(.park-google:hover) .park-cta {
    color: var(--color-lantern);
  }

  /* The two tiles share the box width: two 1fr columns, identical by
     construction. On narrow phones a single column, with grid-auto-rows: 1fr
     keeping the two rows equal. */
  .park-tiles {
    display: grid;
    gap: 0.75rem;
    grid-auto-rows: 1fr;
  }
  /* measured: under 385px the two columns get too narrow for the badge */
  @media (min-width: 385px) {
    .park-tiles {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: auto;
      gap: 1rem;
    }
  }

  .park-google {
    transition:
      transform 0.3s var(--ease-soft),
      box-shadow 0.3s var(--ease-soft);
  }
  a.park-google:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px color-mix(in srgb, black 22%, transparent);
  }

  /* Stars: the gold row is laid over the pale one and clipped at the score */
  .park-stars {
    position: relative;
    flex: none;
    line-height: 0;
  }
  .park-stars-empty,
  .park-stars-full {
    display: flex;
    gap: 0.05rem;
  }
  .park-stars-empty {
    color: color-mix(in srgb, var(--color-night) 20%, transparent);
  }
  .park-stars-full {
    position: absolute;
    inset: 0;
    width: var(--filled, 100%);
    overflow: hidden;
    /* Google's star gold: part of their badge, not of our palette (CODE-06) */
    color: #fbbc04;
  }
  .park-star {
    width: 0.75rem;
    height: 0.75rem;
    flex: none;
    fill: currentColor;
  }
  @media (min-width: 640px) {
    .park-star {
      width: 0.8125rem;
      height: 0.8125rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .park-google {
      transition: none;
    }
    a.park-google:hover {
      transform: none;
    }
  }
</style>
