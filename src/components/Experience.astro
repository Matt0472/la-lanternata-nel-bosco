---
import Divider from './Divider.astro';
import experience from '../data/experience.json';
import hero from '../data/hero.json';

// Rotating skins for the stack: each card must stand apart from the previous
// one, alternating night and paper. On the night cards the pictogram gets a
// warm glow behind it (.glow), not an amber fill: the accent stays the
// lantern's (DES-04).
const skins = [
  { bg: 'bg-night glow', text: 'text-cream', body: 'text-cream/80', rot: 'lg:-rotate-2' },
  { bg: 'bg-paper-warm', text: 'text-night', body: 'text-night-soft', rot: 'lg:rotate-1' },
  { bg: 'bg-dusk glow', text: 'text-cream', body: 'text-cream/80', rot: 'lg:-rotate-1' },
  { bg: 'bg-cream', text: 'text-night', body: 'text-night-soft', rot: 'lg:rotate-2' },
];
---

<section id="esperienza" class="bg-paper pb-20 sm:pb-28">
  <Divider from="night" class="mb-16 sm:mb-20" />
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
      <!-- Text column: it stays still while the cards stack up -->
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="mb-3 text-sm font-bold tracking-[0.2em] text-lantern-deep uppercase" data-animate="fade-up">
          {experience.eyebrow}
        </p>
        <h2 class="text-3xl leading-tight text-balance sm:text-4xl lg:text-5xl" data-animate="fade-up" data-delay="0.1">
          {experience.title}
        </h2>
        <p
          class="mt-5 text-lg leading-relaxed text-pretty whitespace-pre-line text-night-soft"
          data-animate="fade-up"
          data-delay="0.2"
        >
          {experience.intro}
        </p>
        <a
          href="#biglietti"
          class="lift mt-8 inline-block rounded-full bg-lantern px-7 py-3.5 font-bold text-night shadow-lg shadow-night/20 hover:bg-lantern-light"
          data-animate="fade-up"
          data-delay="0.3"
        >
          {hero.ctaLabel}
        </a>
        {
          experience.scrollHint && (
            <p class="mt-8 hidden items-center gap-2 text-sm text-night-soft lg:flex" data-animate="fade-in" data-delay="0.4">
              <span class="h-px w-8 bg-night-soft/40" />
              {experience.scrollHint}
            </p>
          )
        }
      </div>

      <!-- Card stack: every li is sticky, each one stops a little lower -->
      <ul class="grid">
        {
          experience.items.map((item, i) => {
            const skin = skins[i % skins.length];
            return (
              <li style={`--i:${i}`}>
                <article
                  class={`relative overflow-hidden ${skin.bg} ${skin.rot} rounded-[2rem] p-8 shadow-xl shadow-night/15 transition-transform duration-500 ease-soft hover:lg:rotate-0 sm:p-10`}
                >
                  <div class="relative flex items-start justify-between gap-4">
                    <span class="text-5xl" aria-hidden="true">
                      {item.icon}
                    </span>
                    <span class="flex items-center gap-3">
                      {/* in the header row, not at the end: the badge must not
                          change the card height, or the stack loses its rhythm */}
                      {item.extra && experience.extraBadge && (
                        <span
                          class={`rounded-full bg-black/15 px-3 py-1 text-[11px] font-bold tracking-wide uppercase ${skin.text}`}
                        >
                          {experience.extraBadge}
                        </span>
                      )}
                      <span class={`font-display text-2xl tabular-nums ${skin.body}`} aria-hidden="true">
                        {String(i + 1).padStart(2, '0')}
                      </span>
                    </span>
                  </div>
                  <h3 class={`relative mt-6 text-2xl sm:text-3xl ${skin.text}`}>{item.title}</h3>
                  <p class={`relative mt-3 text-lg leading-relaxed text-pretty ${skin.body}`}>{item.text}</p>
                </article>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Each card stops a little lower than the previous one: the stack stays
     visible. The space below is what gives the effect its scroll time. */
  #esperienza li {
    --top-base: 6.5rem;
    position: sticky;
    top: calc(var(--top-base) + var(--i) * 0.9rem);
    min-height: 19rem;
    margin-bottom: 2.5rem;
  }
  @media (min-width: 640px) {
    #esperienza li {
      --top-base: 8rem;
    }
  }
  /* No "runway" or spacers after the last card: any stretch where the stack
     stays pinned while the page scrolls reads as "the section moves by itself"
     (DES-10). The last card never pins: it converges on the one before, covers
     it, and the stack peels away with the last one always on top. */
  @media (min-width: 1024px) {
    #esperienza li {
      margin-bottom: 5rem;
    }
  }
  /* On short screens the stack becomes a plain list: sticky would feel cramped (RESP-07) */
  @media (max-height: 620px) {
    #esperienza li {
      position: static;
      margin-bottom: 1.5rem;
      min-height: 0;
    }
  }

  /* The light of the night cards: a warm glow behind the pictogram, as if it
     were lit */
  .glow::before {
    content: '';
    position: absolute;
    top: -2.5rem;
    left: -1.5rem;
    width: 12rem;
    aspect-ratio: 1;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-lantern-light) 45%, transparent) 0%,
      color-mix(in srgb, var(--color-lantern) 18%, transparent) 40%,
      transparent 70%
    );
    pointer-events: none;
  }
</style>
