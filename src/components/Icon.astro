---
// The site's line icon set. One style: stroke 1.8, soft corners (DES-07).
interface Props {
  name: string;
  class?: string;
}
const { name, class: cls = 'h-6 w-6' } = Astro.props;

const icons: Record<string, string> = {
  basket: `<path d="M3.5 10 h17 l-1.6 8.4 a2 2 0 0 1-2 1.6 H7.1 a2 2 0 0 1-2-1.6 Z"/><path d="M8 10 l3-5.5"/><path d="M16 10 l-3-5.5"/><path d="M9.5 13.5 v3"/><path d="M14.5 13.5 v3"/>`,
  pen: `<path d="M4.5 19.5 l1-4 L16 4.5 a2.1 2.1 0 0 1 3 3 L8.5 18.5 Z"/><path d="M14 6.5 l3 3"/><path d="M13 19.5 h6.5"/>`,
  calendar: `<rect x="4" y="6" width="16" height="14" rx="2"/><path d="M4 11 h16"/><path d="M8.5 3.5 v4"/><path d="M15.5 3.5 v4"/>`,
  ticket: `<path d="M2 9 a3 3 0 0 1 0 6 v2 a2 2 0 0 0 2 2 h16 a2 2 0 0 0 2-2 v-2 a3 3 0 0 1 0-6 V7 a2 2 0 0 0-2-2 H4 a2 2 0 0 0-2 2 Z"/><path d="M13.5 5.5 v2.5"/><path d="M13.5 11 v2"/><path d="M13.5 16 v2.5"/>`,
  phone: `<path d="M21 16.5 v2.6 a1.9 1.9 0 0 1-2.1 1.9 18.6 18.6 0 0 1-8.1-2.9 18.3 18.3 0 0 1-5.6-5.6 A18.6 18.6 0 0 1 2.3 4.3 1.9 1.9 0 0 1 4.2 2.2 h2.6 a1.9 1.9 0 0 1 1.9 1.6 c.1.9.4 1.8.7 2.6 a1.9 1.9 0 0 1-.4 2 L7.8 9.6 a15 15 0 0 0 5.6 5.6 l1.2-1.2 a1.9 1.9 0 0 1 2-.4 c.8.3 1.7.6 2.6.7 a1.9 1.9 0 0 1 1.8 1.9 Z"/>`,
  email: `<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4.5 7.5 12 13 l7.5-5.5"/>`,
  pin: `<path d="M12 21 c-2.5-2.2-7-6.4-7-10.6 a7 7 0 0 1 14 0 c0 4.2-4.5 8.4-7 10.6 Z"/><circle cx="12" cy="10.2" r="2.5"/>`,
  moon: `<path d="M20 13.5 A8.5 8.5 0 1 1 10.5 4 a7 7 0 0 0 9.5 9.5 Z"/>`,
  star: `<path d="M12 3 l2 6.2 6.2 2-6.2 2 -2 6.2 -2-6.2 -6.2-2 6.2-2 Z"/>`,
  card: `<rect x="2.5" y="5" width="19" height="14" rx="2.5"/><path d="M2.5 9.5 h19"/><path d="M6 15.5 h4"/>`,
  external: `<path d="M14 4.5 h5.5 V10"/><path d="M19.5 4.5 11 13"/><path d="M18 14 v4 a1.5 1.5 0 0 1-1.5 1.5 h-10 A1.5 1.5 0 0 1 5 18 V8 a1.5 1.5 0 0 1 1.5-1.5 h4"/>`,
  instagram: `<rect x="3.5" y="3.5" width="17" height="17" rx="4.5"/><circle cx="12" cy="12" r="3.8"/><circle cx="17" cy="7" r="0.5" fill="currentColor"/>`,
  facebook: `<path d="M18 2.5 h-2.5 a4.5 4.5 0 0 0-4.5 4.5 v3 H8 v4 h3 v7.5 h4 V14 h3 l1-4 h-4 V7 a1 1 0 0 1 1-1 h3 Z"/>`,
};
const body = icons[name] ?? icons.star;
---

<svg
  class={cls}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={body}
/>
